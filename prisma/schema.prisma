generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  createdAt DateTime    @default(now())
  watchlist Watchlist[]
  comments  Comment[]
}

model Watchlist {
  id          String   @id @default(cuid())
  userId      String
  movieId     Int
  movieTitle  String
  moviePoster String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  movieId   Int
  content   String
  userName  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
